{
  "id": "prodcom-transcript",
  "name": "ProdCom",
  "version": "1.3.0",
  "proddash": ">=1.1.0",
  "description": "Live ProdCom transcript",
  "permissions": [
    {
      "kind": "local-network",
      "reason": "Reaching the ProdCom API on this network"
    }
  ],
  "client": "client.js",
  "server": "server.js",
  "style": "style.css",
  "minSize": {
    "w": 3,
    "h": 2
  },
  "defaultSize": {
    "w": 4,
    "h": 4
  },
  "configSchema": {
    "prodcom": {
      "type": "endpoint",
      "label": "ProdCom server",
      "default": {
        "host": "10.3.11.152",
        "port": 24480
      }
    },
    "apiKey": {
      "type": "password",
      "label": "API key (only if PSK auth is enabled in ProdCom)",
      "default": ""
    }
  },
  "instanceSchema": {
    "showAvatars": {
      "type": "boolean",
      "label": "Show channel icons",
      "default": true
    }
  }
}
