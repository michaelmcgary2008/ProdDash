{
  "id": "propresenter-timers",
  "name": "Timers",
  "version": "1.2.0",
  "proddash": ">=1.2.0",
  "description": "Live ProPresenter timers and LTC timecode",
  "client": "client.js",
  "server": "server.js",
  "style": "style.css",
  "minSize": { "w": 2, "h": 1 },
  "defaultSize": { "w": 4, "h": 2 },
  "configSchema": {
    "propresenter": {
      "type": "endpoint",
      "label": "ProPresenter",
      "group": "ProPresenter",
      "default": { "host": "", "port": 1025 }
    },
    "password": {
      "type": "password",
      "label": "API password (only if set in ProPresenter)",
      "group": "ProPresenter",
      "default": ""
    },
    "ltcEnabled": {
      "type": "switch",
      "label": "LTC listener — decode timecode from an audio input on this machine",
      "group": "LTC Timecode",
      "default": false
    },
    "ltcDevice": {
      "type": "select",
      "label": "Audio device",
      "group": "LTC Timecode",
      "showWhen": "ltcEnabled",
      "default": "",
      "optionsRoute": "/ltc/devices"
    },
    "ltcChannel": {
      "type": "number",
      "label": "Channel on that device (1-based)",
      "group": "LTC Timecode",
      "showWhen": "ltcEnabled",
      "default": 1
    },
    "timerFont": {
      "type": "select",
      "label": "Timer font",
      "group": "Display",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default (system)" },
        { "value": "monospace", "label": "Monospace — steadier changing digits" }
      ]
    }
  }
}
